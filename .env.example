# Discord Bot Configuration
# Get your bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# OpenTelemetry OTLP Configuration (Optional)
# If not set, logs will only be written to console

# OTLP endpoint for traces and logs
# Examples:
# - Local Jaeger: http://localhost:4317
# - Local OTEL Collector: http://localhost:4317
# - Grafana Cloud: https://otlp-gateway-prod-XXX.grafana.net/otlp
# - Honeycomb: https://api.honeycomb.io:443
OTLP_ENDPOINT=

# OTLP headers for authentication (format: "key1=value1,key2=value2")
# Examples:
# - Grafana Cloud: "Authorization=Basic <base64_instance_id:token>"
# - Honeycomb: "x-honeycomb-team=your_api_key"
# - Generic API Key: "Authorization=Bearer your_token"
OTLP_HEADERS=

# Environment label for traces and logs (Optional, defaults to 'production')
# Common values: development, staging, production
ENVIRONMENT=production

# Logging level (Optional, defaults to 'info')
# Valid levels: error, warn, info, debug, trace
# You can also set per-module levels: RUST_LOG=info,tokio=warn,serenity=debug
RUST_LOG=info
