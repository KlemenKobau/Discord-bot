# Discord Bot Configuration
# Get your bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# Loki Logging Configuration (Optional)
# If not set, logs will only be written to console

# For self-hosted Loki:
# LOKI_URL=http://localhost:3100

# For Grafana Cloud:
# LOKI_URL=https://logs-prod-XXX.grafana.net/loki/api/v1/push
# LOKI_USERNAME=your_grafana_cloud_user_id
# LOKI_API_KEY=your_grafana_cloud_api_token

LOKI_URL=
LOKI_USERNAME=
LOKI_API_KEY=

# Environment label for Loki logs (Optional, defaults to 'production')
# Common values: development, staging, production
ENVIRONMENT=production
