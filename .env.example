# Discord Bot Configuration
# Get your bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# OpenTelemetry OTLP Configuration (Optional)
# If not set, logs will only be written to console

# OTLP endpoint for logs
# For PostHog: The code automatically converts this to the correct HTTP logs endpoint
# PostHog currently only supports logs via HTTP, not traces via gRPC
# Examples:
# - PostHog EU: https://eu.posthog.com:443 (auto-converts to https://eu.i.posthog.com/i/v1/logs)
# - PostHog US: https://us.posthog.com:443 (auto-converts to https://us.i.posthog.com/i/v1/logs)
# - Local OTEL Collector: http://localhost:4318/v1/logs
# - Grafana Cloud Loki: https://logs-prod-XXX.grafana.net/loki/api/v1/push
OTLP_ENDPOINT=https://eu.posthog.com:443

# OTLP headers for authentication (format: "key1=value1,key2=value2")
# Examples:
# - PostHog: "Authorization=Bearer phc_your_api_key"
# - Grafana Cloud: "Authorization=Basic <base64_instance_id:token>"
# - Honeycomb: "x-honeycomb-team=your_api_key"
# - Generic API Key: "Authorization=Bearer your_token"
OTLP_HEADERS=Authorization=Bearer phc_your_posthog_api_key_here

# Environment label for traces and logs (Optional, defaults to 'production')
# Common values: development, staging, production
ENVIRONMENT=production

# Logging level (Optional, defaults to 'info')
# Valid levels: error, warn, info, debug, trace
# You can also set per-module levels: RUST_LOG=info,tokio=warn,serenity=debug
RUST_LOG=info
